(* Ocelot component showcase.

   Renders a sample page exercising every available component in both
   light and dark themes (toggle the data-ocelot-theme attribute with the
   button in the header). Build and run:

     dune exec examples/showcase/showcase.exe > showcase.html *)

open Ocelot

let page_title = "Ocelot Component Showcase"

(* Inline script: toggles the theme attribute on the root element. *)
let toggle_theme_script =
  JSX.unsafe
    {|
(function () {
  var root = document.documentElement;
  root.setAttribute('data-ocelot-theme', 'light');
  window.ocelotToggleTheme = function () {
    var current = root.getAttribute('data-ocelot-theme');
    root.setAttribute('data-ocelot-theme', current === 'dark' ? 'light' : 'dark');
  };
})();
|}

let theme_toggle =
  JSX.node "button"
    [ ("type", `String "button")
    ; ("class", `String "ocelot-button ocelot-button--secondary")
    ; ("onclick", `String "ocelotToggleTheme()") ]
    [ JSX.string "Toggle theme" ]

let tabs =
  [
    { Tabs.id = "overview"; label = "Overview";
      panel = (fun () ->
          <Text color=Text.Secondary>
            "Everything you need to know, in one place."
          </Text>) };
    { Tabs.id = "specs"; label = "Specifications";
      panel = (fun () ->
          <Text color=Text.Secondary>
            "Technical details and configuration options."
          </Text>) };
    { Tabs.id = "reviews"; label = "Reviews";
      panel = (fun () ->
          <Text color=Text.Secondary>
            "What people are saying about it."
          </Text>) };
  ]

let select_options =
  [
    { Select.value = "ocaml"; label = "OCaml"; disabled = false };
    { Select.value = "reason"; label = "Reason"; disabled = false };
    { Select.value = "rescript"; label = "ReScript"; disabled = true };
  ]

let dropdown_options =
  [ ("ocaml", "OCaml"); ("reason", "Reason"); ("fsharp", "F#"); ("sml", "Standard ML") ]

let sidebar_items =
  [
    { Sidebar.href = "/"; label = "Dashboard"; icon = Some (JSX.string "◧");
      is_current = true; disabled = false };
    { Sidebar.href = "/projects"; label = "Projects"; icon = Some (JSX.string "▤");
      is_current = false; disabled = false };
    { Sidebar.href = "/team"; label = "Team"; icon = Some (JSX.string "◍");
      is_current = false; disabled = false };
    { Sidebar.href = "/settings"; label = "Settings"; icon = Some (JSX.string "⚙");
      is_current = false; disabled = false };
    { Sidebar.href = "/billing"; label = "Billing"; icon = Some (JSX.string "$");
      is_current = false; disabled = true };
  ]

let header_nav_items =
  [
    { Header.href = "/search"; label = "Search"; is_current = true; disabled = false };
    { Header.href = "/docs"; label = "Docs"; is_current = false; disabled = false };
    { Header.href = "/support"; label = "Support"; is_current = false; disabled = true };
  ]

let user_menu_options =
  [ ("profile", "Profile"); ("settings", "Settings"); ("signout", "Sign out") ]

let page =
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>(JSX.string page_title)</title>
      <script>(toggle_theme_script)</script>
      (Css.render ())
      (Alpine.script ())
    </head>
    <body
      style="padding: 2rem; font-family: var(--ocelot-font-body); color: var(--ocelot-text-primary); background: var(--ocelot-background); max-width: 64rem; margin: 0 auto;">
      <Flex justify=Between align=Center>
        <h1>(JSX.string page_title)</h1>
        (theme_toggle)
      </Flex>
      <Divider />

      <section style="margin: 2rem 0;">
        <h2>"Buttons"</h2>
        <Flex gap=G3 responsive=Sm>
          <Button variant=Primary>"Primary"</Button>
          <Button variant=Secondary>"Secondary"</Button>
          <Button variant=Ghost>"Ghost"</Button>
          <Button variant=Danger>"Danger"</Button>
          <Button variant=Primary disabled=true>"Disabled"</Button>
        </Flex>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Typography"</h2>
        <Stack gap=G2>
          <Text tag="h3" size=Text.Xl weight=Text.Bold color=Text.Heading>"Heading Text"</Text>
          <Text color=Text.Secondary>"Secondary body text for descriptions."</Text>
          <Text color=Text.Muted size=Text.Sm>"Small muted caption text."</Text>
        </Stack>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Badges"</h2>
        <Flex gap=G2>
          <Badge variant=Primary>"Primary"</Badge>
          <Badge variant=Secondary>"Secondary"</Badge>
          <Badge variant=Success>"Success"</Badge>
          <Badge variant=Warning>"Warning"</Badge>
          <Badge variant=Danger>"Danger"</Badge>
          <Badge variant=Info>"Info"</Badge>
        </Flex>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Alerts"</h2>
        <Stack gap=G3>
          <Alert variant=Success>"Your changes have been saved successfully."</Alert>
          <Alert variant=Warning>"Please review your input before continuing."</Alert>
          <Alert variant=Danger>"An error occurred while processing your request."</Alert>
          <Alert variant=Info>"This is an informational message for the user."</Alert>
        </Stack>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Card"</h2>
        <Card shadow=Card.Md>
          <Card.Header>
            <Text tag="h3" weight=Text.Semibold color=Text.Heading>"Card Title"</Text>
          </Card.Header>
          <Card.Body>
            "This is a card body with some content inside. Cards can contain headers, bodies, and footers."
          </Card.Body>
          <Card.Footer>
            <Flex justify=End>
              <Button variant=Primary>"Action"</Button>
            </Flex>
          </Card.Footer>
        </Card>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Form Inputs"</h2>
        <Stack gap=G4>
          <Stack gap=G1>
            <Label for_="email">"Email address"</Label>
            <Input type_="email" name="email" id="email" placeholder="you@example.com" />
          </Stack>
          <Stack gap=G1>
            <Label for_="bio">"Bio"</Label>
            <Textarea name="bio" id="bio" placeholder="Tell us about yourself..." />
          </Stack>
          <Stack gap=G1>
            <Label for_="lang">"Favorite language (native select)"</Label>
            <Select name="lang" id="lang" options=select_options />
          </Stack>
          <Stack gap=G1>
            <Text color=Text.Muted size=Text.Sm>"Favorite language (Alpine dropdown)"</Text>
            <Dropdown placeholder="Pick one..." options=dropdown_options aria_label="Languages" />
          </Stack>
        </Stack>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Checkboxes, Radios & Switches"</h2>
        <Stack gap=G4>
          <Stack gap=G2>
            <Text tag="h3" size=Text.Sm weight=Text.Semibold color=Text.Secondary>"Features"</Text>
            <Checkbox name="features" value="storage" checked=true>"Extra storage"</Checkbox>
            <Checkbox name="features" value="support">"Priority support"</Checkbox>
            <Checkbox name="features" value="domain" disabled=true>"Custom domain"</Checkbox>
          </Stack>
          <Radio_group label="Billing plan">
            <Radio_group.Item name="plan" value="free" checked=true>"Free"</Radio_group.Item>
            <Radio_group.Item name="plan" value="pro">"Pro"</Radio_group.Item>
            <Radio_group.Item name="plan" value="enterprise" disabled=true>"Enterprise"</Radio_group.Item>
          </Radio_group>
          <Stack gap=G2>
            <Text tag="h3" size=Text.Sm weight=Text.Semibold color=Text.Secondary>"Notifications"</Text>
            <Switch name="alerts" checked=true>"Email alerts"</Switch>
            <Switch name="newsletter">"Weekly newsletter"</Switch>
            <Switch name="tips" disabled=true>"Product tips (disabled)"</Switch>
          </Stack>
        </Stack>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Progress & Spinner"</h2>
        <Stack gap=G4>
          <Stack gap=G2>
            <Text color=Text.Secondary size=Text.Sm>"Uploading — 70%"</Text>
            <Progress value=0.7 aria_label="Upload progress" />
            <Text color=Text.Secondary size=Text.Sm>"Processing — 35%"</Text>
            <Progress value=0.35 aria_label="Processing" />
            <Text color=Text.Secondary size=Text.Sm>"Unknown duration"</Text>
            <Progress indeterminate=true aria_label="Loading" />
          </Stack>
          <Flex gap=G4 align=Center>
            <Spinner />
            <Spinner size=Sm>"Fetching data…"</Spinner>
            <Spinner size=Lg />
          </Flex>
        </Stack>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Scroll Area"</h2>
        <Scroll_area max_height="8rem" class_="ocelot-box--border ocelot-box--padding-3">
          <Stack gap=G2>
            <Text>"This content overflows its 8rem-tall container: scroll it with the thin, themeable scrollbar."</Text>
            <Text color=Text.Secondary>"Ocelot is a library of UI components that render to plain HTML strings on the server."</Text>
            <Text color=Text.Secondary>"Components are accessible by default, with semantic markup and ARIA attributes."</Text>
            <Text color=Text.Secondary>"Styles are embedded in the library and emitted as a single style tag — no CSS build step."</Text>
            <Text color=Text.Secondary>"Themes are records of design tokens compiled to CSS custom properties."</Text>
          </Stack>
        </Scroll_area>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Sidebar"</h2>
        <Text color=Text.Secondary size=Text.Sm>
          "A full-height, side-pinned shell with a scrollable nav between pinned header and footer."
          " Resize the window: it collapses to an icon rail on medium widths and becomes an"
          " off-canvas drawer on small ones."
        </Text>
        <Sidebar
          aria_label="Main navigation"
          header=(<Stack gap=G0><Text weight=Text.Bold color=Text.Heading>"Ocelot"</Text><Text size=Text.Sm color=Text.Muted>"Admin console"</Text></Stack>)
          footer=(<Text color=Text.Muted>"v0.1.0 — signed in as Ada"</Text>)
          items=sidebar_items>
          <Stack gap=G4 class_="ocelot-box--padding-8">
            <Text tag="h3" weight=Text.Semibold color=Text.Heading>"Main content area"</Text>
            <Text color=Text.Secondary>
              "This region flexes to the space left by the sidebar — resize the window to watch it adapt."
            </Text>
          </Stack>
        </Sidebar>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Header"</h2>
        <Text color=Text.Secondary size=Text.Sm>
          "A sticky topbar with a brand link, horizontal nav, and an actions slot —"
          " here a theme toggle and a Dropdown user menu. The nav scrolls horizontally"
          " when cramped; it works standalone, with no JavaScript at all."
        </Text>
        <Header
          aria_label="Primary"
          brand=(<Text weight=Text.Bold color=Text.Heading>"Ocelot"</Text>)
          items=header_nav_items
          actions=(<Flex gap=G2 align=Center>(theme_toggle)<Dropdown placeholder="Ada Lovelace" options=user_menu_options aria_label="User menu" /></Flex>) />
      </section>

      <section style="margin: 2rem 0;">
        <h2>"App shell (Header + Sidebar)"</h2>
        <Text color=Text.Secondary size=Text.Sm>
          "Header and Sidebar compose into the full app shell: the Sidebar's own mobile bar is"
          " disabled (mobile_bar=false) and its drawer trigger lives in the Header instead —"
          " shrink the window below 40rem to see the hamburger appear top-left."
        </Text>
        <Sidebar
          id="app-shell-sidebar"
          aria_label="Main navigation"
          mobile_bar=false
          header=(<Stack gap=G0><Text weight=Text.Bold color=Text.Heading>"Ocelot"</Text><Text size=Text.Sm color=Text.Muted>"Admin console"</Text></Stack>)
          footer=(<Text color=Text.Muted>"v0.1.0 — signed in as Ada"</Text>)
          items=sidebar_items>
          <Header
            sidebar_id="app-shell-sidebar"
            aria_label="Primary"
            items=header_nav_items
            actions=(<Button variant=Primary>"New project"</Button>)>
            <Input type_="search" name="q" placeholder="Search projects…" />
          </Header>
          <Stack gap=G4 class_="ocelot-box--padding-8">
            <Text tag="h3" weight=Text.Semibold color=Text.Heading>"Main content area"</Text>
            <Text color=Text.Secondary>
              "This region flexes to the space left by the sidebar — resize the window to watch it adapt."
            </Text>
          </Stack>
        </Sidebar>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Calendar"</h2>
        <Flex gap=G8 align=Start>
          <Stack gap=G2>
            <Text color=Text.Secondary size=Text.Sm>"Monday-first, multi-day selection, disabled days — day buttons submit their ISO date."</Text>
            <Calendar
              year=2025 month=6 name="date"
              selected=[3; 15] today=15 disabled=[20; 26]
              prev_href="#" next_href="#" />
          </Stack>
          <Stack gap=G2>
            <Text color=Text.Secondary size=Text.Sm>"Sunday-first weeks, no form field."</Text>
            <Calendar year=2025 month=6 week_start=Calendar.Sun today=1 />
          </Stack>
        </Flex>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Table"</h2>
        <Table>
          <Table.Head>
            <Table.Row>
              <Table.HeaderCell>"Name"</Table.HeaderCell>
              <Table.HeaderCell>"Role"</Table.HeaderCell>
              <Table.HeaderCell>"Status"</Table.HeaderCell>
            </Table.Row>
          </Table.Head>
          <Table.Body>
            <Table.Row>
              <Table.Cell>"Alice"</Table.Cell>
              <Table.Cell>"Admin"</Table.Cell>
              <Table.Cell><Badge variant=Success>"Active"</Badge></Table.Cell>
            </Table.Row>
            <Table.Row>
              <Table.Cell>"Bob"</Table.Cell>
              <Table.Cell>"Editor"</Table.Cell>
              <Table.Cell><Badge variant=Warning>"Pending"</Badge></Table.Cell>
            </Table.Row>
          </Table.Body>
        </Table>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Tabs"</h2>
        <Tabs aria_label="Product information" tabs=tabs />
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Accordion"</h2>
        <Accordion>
          <Accordion.Item title="What is Ocelot?">
            <Text color=Text.Secondary>
              "A themable library of UI components for server-side HTML, written in OCaml."
            </Text>
          </Accordion.Item>
          <Accordion.Item title="Do I need JavaScript?">
            <Text color=Text.Secondary>
              "Only for interactive components: Alpine.js (~15kb) powers tabs, accordions, modals, toasts, tooltips, and dropdowns."
            </Text>
          </Accordion.Item>
          <Accordion.Item open_=true title="How do I switch themes?">
            <Text color=Text.Secondary>
              "Toggle the data-ocelot-theme attribute between light and dark - try the button at the top of this page."
            </Text>
          </Accordion.Item>
        </Accordion>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Modal"</h2>
        <Modal
          title="Confirm deletion"
          trigger=(<Button variant=Danger>"Delete project"</Button>)
          content=(
            <Stack gap=G4>
              <Text>
                "This action cannot be undone. All project data will be permanently removed."
              </Text>
              <Flex justify=End gap=G2>
                <Button variant=Ghost>"Cancel"</Button>
                <Button variant=Danger>"Yes, delete it"</Button>
              </Flex>
            </Stack>) />
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Tooltip"</h2>
        <Flex gap=G4>
          <Tooltip text="Helpful extra information appears on hover and focus." focusable=true>
            "Hover or focus me"
          </Tooltip>
          <Tooltip text="This one appears below the trigger." position=Tooltip.Bottom>
            <Button variant=Ghost>"Button with tooltip"</Button>
          </Tooltip>
        </Flex>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Pagination"</h2>
        <Pagination>
          <Pagination.Item is_disabled=true>"Previous"</Pagination.Item>
          <Pagination.Item is_current=true>"1"</Pagination.Item>
          <Pagination.Item href="#">"2"</Pagination.Item>
          <Pagination.Item href="#">"3"</Pagination.Item>
          <Pagination.Ellipsis />
          <Pagination.Item href="#">"Next"</Pagination.Item>
        </Pagination>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Breadcrumb"</h2>
        <Breadcrumb>
          <Breadcrumb.Item href="/">"Home"</Breadcrumb.Item>
          <Breadcrumb.Item href="/docs">"Documentation"</Breadcrumb.Item>
          <Breadcrumb.Item is_current=true>"Components"</Breadcrumb.Item>
        </Breadcrumb>
      </section>

      <section style="margin: 2rem 0;">
        <h2>"Links"</h2>
        <Flex gap=G4>
          <Link href="https://example.com">"Default link"</Link>
          <Link href="https://example.com" variant=Muted>"Muted link"</Link>
          <Link href="https://example.com" external_=true>"External link →"</Link>
        </Flex>
      </section>

      <Toast.Container>
        <Toast variant=Success>"Project saved successfully."</Toast>
        <Toast variant=Warning duration=8000>"Sticky a little longer."</Toast>
      </Toast.Container>
    </body>
  </html>

let () =
  let html = JSX.render page in
  Printf.printf "%s\n" html
