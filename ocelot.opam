# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Themable UI components for server-side HTML in OCaml"
description:
  "Ocelot is a library of beautifully-designed, accessible, and themeable UI components for generating server-side HTML using html_of_jsx."
maintainer: ["Jean-Michel Bea <code@jm-bea.net>"]
authors: ["Jean-Michel Bea <code@jm-bea.net>"]
license: "MIT"
homepage: "https://github.com/beajeanm/ocelot"
bug-reports: "https://github.com/beajeanm/ocelot/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.20" & >= "3.24"}
  "html_of_jsx" {>= "0.1.0"}
  "calendar" {>= "3.0.0"}
  "ppxlib" {>= "0.32.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/beajeanm/ocelot.git"
x-maintenance-intent: ["(latest)"]
